generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BudgetMonthStatus {
  OPEN
  CLOSED
}

enum AllocationType {
  INCOME_ASSIGNMENT
  CATEGORY_TRANSFER
  MANUAL_ADJUSTMENT
}

enum PlannedExpenseStatus {
  PLANNED
  RESERVED
  COMPLETED
  CANCELLED
}

enum CarryOverPolicy {
  RESET
  CARRY
  TRANSFER_TO_FREE
}

enum IncomeStatus {
  RECEIVED
  EXPECTED
}

enum AllocationRuleLineMode {
  FIXED
  PERCENT
}

model Income {
  id           String       @id @default(uuid())
  user_id      String
  amount       Decimal
  source       String?
  income_type  String       @default("salary")
  status       IncomeStatus @default(RECEIVED)
  period_month DateTime
  received_at  DateTime?
  created_at   DateTime     @default(now())

  allocations Allocation[]

  @@index([user_id, status])
}

model Category {
  id                String          @id @default(uuid())
  user_id           String
  name              String
  type              String
  icon              String          @default("shopping-cart")
  icon_color        String          @default("purple")
  carry_over_policy CarryOverPolicy @default(RESET)
  created_at        DateTime        @default(now())

  allocations            Allocation[]
  allocationRuleLines    AllocationRuleLine[]
  expenses               Expense[]
  plannedExpenses        PlannedExpense[]
  categoryMonthSnapshots CategoryMonthSnapshot[]
  transfersFrom          Transfer[]              @relation("TransferFrom")
  transfersTo            Transfer[]              @relation("TransferTo")
}

model AllocationRule {
  id                  String   @id @default(uuid())
  user_id             String
  name                String
  trigger_income_type String?
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  lines AllocationRuleLine[]

  @@index([user_id, is_active])
}

model AllocationRuleLine {
  id          String                 @id @default(uuid())
  rule_id     String
  rule        AllocationRule         @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  category_id String
  category    Category               @relation(fields: [category_id], references: [id])
  mode        AllocationRuleLineMode
  amount      Decimal?
  percent     Decimal?
  position    Int                    @default(0)
  created_at  DateTime               @default(now())

  @@index([rule_id, position])
  @@index([category_id])
}

model Allocation {
  id           String         @id @default(uuid())
  user_id      String
  income_id    String
  income       Income         @relation(fields: [income_id], references: [id])
  category_id  String
  category     Category       @relation(fields: [category_id], references: [id])
  amount       Decimal
  type         AllocationType @default(INCOME_ASSIGNMENT)
  period_month DateTime
  created_at   DateTime       @default(now())

  @@index([user_id, period_month])
}

model Transfer {
  id               String    @id @default(uuid())
  user_id          String
  from_category_id String
  from_category    Category  @relation("TransferFrom", fields: [from_category_id], references: [id])
  /** null = списание из накоплений в свободный пул (без конверта-получателя). */
  to_category_id   String?
  to_category      Category? @relation("TransferTo", fields: [to_category_id], references: [id])
  amount           Decimal
  period_month     DateTime
  created_at       DateTime  @default(now())

  @@index([user_id, period_month])
}

model Expense {
  id          String   @id @default(uuid())
  user_id     String
  category_id String
  category    Category @relation(fields: [category_id], references: [id])
  amount      Decimal
  description String?
  date        DateTime
  created_at  DateTime @default(now())

  completedFromPlan PlannedExpense?
}

model BudgetMonth {
  id         String            @id @default(uuid())
  user_id    String
  year       Int
  month      Int
  status     BudgetMonthStatus @default(OPEN)
  opened_at  DateTime          @default(now())
  closed_at  DateTime?
  created_at DateTime          @default(now())

  snapshots       CategoryMonthSnapshot[]
  closeReport     MonthCloseReport?
  plannedExpenses PlannedExpense[]

  @@unique([user_id, year, month])
  @@index([user_id, status])
}

model PlannedExpense {
  id                   String               @id @default(uuid())
  user_id              String
  title                String
  description          String?
  icon_name            String               @default("gift")
  icon_color           String               @default("purple")
  amount               Decimal
  reserved_amount      Decimal              @default(0)
  planned_date         DateTime
  planned_date_end     DateTime?
  status               PlannedExpenseStatus @default(PLANNED)
  category_id          String?
  category             Category?            @relation(fields: [category_id], references: [id])
  budget_month_id      String
  budgetMonth          BudgetMonth          @relation(fields: [budget_month_id], references: [id], onDelete: Cascade)
  completed_expense_id String?              @unique @db.Uuid
  completedExpense     Expense?             @relation(fields: [completed_expense_id], references: [id], onDelete: SetNull)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  @@index([user_id, budget_month_id])
  @@index([budget_month_id, status])
}

model CategoryMonthSnapshot {
  id              String      @id @default(uuid())
  budget_month_id String
  budgetMonth     BudgetMonth @relation(fields: [budget_month_id], references: [id], onDelete: Cascade)
  category_id     String
  category        Category    @relation(fields: [category_id], references: [id])
  user_id         String
  year            Int
  month           Int
  opening_balance Decimal     @default(0)
  allocated       Decimal     @default(0)
  spent           Decimal     @default(0)
  closing_balance Decimal     @default(0)
  version         Int         @default(0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  @@unique([budget_month_id, category_id])
  @@index([user_id, year, month])
  @@index([category_id])
}

model MonthCloseReport {
  id                  String      @id @default(uuid())
  budget_month_id     String      @unique
  budgetMonth         BudgetMonth @relation(fields: [budget_month_id], references: [id], onDelete: Cascade)
  income_total        Decimal
  spent_total         Decimal
  reserved_total      Decimal
  overspent_total     Decimal
  carry_forward_total Decimal
  warnings_json       Json?
  closed_at           DateTime    @default(now())
  created_at          DateTime    @default(now())
}
